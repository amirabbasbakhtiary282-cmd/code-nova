# ---------------------------------------------------------------------------
# CodeNova environment template — copy to .env and fill in real values.
# NEVER commit .env (it is gitignored). No real secret belongs in this file.
# ---------------------------------------------------------------------------

# --- Auth (NextAuth v5 / Auth.js) -------------------------------------------
# Required for sessions. Generate with:  openssl rand -base64 32
AUTH_SECRET=""
# Legacy alias read by some tooling — set to the same value as AUTH_SECRET.
NEXTAUTH_SECRET=""
# Canonical URL of the app (deployment URL in production).
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# --- Database (live dev/preview driver: SQLite) ------------------------------
# Optional. Default: ./data/codenova.db (auto-created, auto-migrated,
# auto-seeded from src/content on first use).
# DB_FILE="./data/codenova.db"

# --- Database (production path: Prisma + MySQL) ------------------------------
# Used by the Prisma CLI (prisma.config.ts) and the reference repository in
# prisma/reference/. See prisma/README.md for the full switch guide.
DATABASE_URL="mysql://user:pass@localhost:3306/codenova"
